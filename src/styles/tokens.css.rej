diff a/src/styles/tokens.css b/src/styles/tokens.css	(rejected hunks)
@@ -25,12 +25,25 @@
   --ama-line:       #dde3dc;
   --ama-line-2:     #eef1ec;
 
-  --ama-green:      #0f6b3f;   /* primary */
-  --ama-green-deep: #0a4e2e;
+  --ama-green:      #0f6b3f;   /* primary — dark green */
+  --ama-green-deep: #0a4e2e;   /* headings, top nav, brand bar */
+  --ama-green-darker: #063a22;
   --ama-green-soft: #e6f1ea;
   --ama-brass:      #b8862b;   /* accent — crest/seal/medal */
   --ama-brass-soft: #f6efdd;
 
+  /* Secondary family. The brief was "don't make every component
+     green": emerald carries active states, progress and highlights so
+     the dark green stays reserved for brand and structure. */
+  --ama-emerald:      #1f9d61;
+  --ama-emerald-deep: #157a4a;
+  --ama-emerald-soft: #e8f7ef;
+
+  /* Neutral surfaces — off-white rather than pure white, so cards
+     read as paper against the page and print cleanly. */
+  --ama-mist:       #fbfcfa;
+  --ama-shade:      #ecefe9;
+
   --ama-danger:      #b3261e;
   --ama-danger-soft: #fbeae9;
   --ama-warn:        #8a5a00;
@@ -100,6 +113,11 @@
   --ama-line-2:    #1f2c25;
 
   --ama-green-soft: #16301f;
+  --ama-emerald:      #35b87a;
+  --ama-emerald-deep: #2a9c66;
+  --ama-emerald-soft: #14301f;
+  --ama-mist:       #111c16;
+  --ama-shade:      #1b2821;
   --ama-brass-soft: #2e2510;
   --ama-danger-soft:#2f1512;
   --ama-warn-soft:  #2c2109;
