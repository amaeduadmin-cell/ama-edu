diff a/src/styles/marketing.css b/src/styles/marketing.css	(rejected hunks)
@@ -215,3 +215,60 @@
 .steps { display: flex; gap: var(--s-2); margin-bottom: var(--s-5); }
 .step { flex: 1; height: 3px; border-radius: 2px; background: var(--ama-line); }
 .step.done { background: var(--brand-primary); }
+
+/* ===============================================================
+   Public content pages — school profiles (/schools/<slug>) and the
+   blog (/blog). These are the crawlable, logged-out surfaces, so
+   they keep the platform palette rather than a school's branding,
+   except for the school crest itself.
+   =============================================================== */
+
+.marketing {
+  max-width: 760px;
+  margin: 0 auto;
+  padding: var(--s-5) var(--s-4) var(--s-8);
+}
+
+.mk-hero {
+  text-align: center;
+  padding: var(--s-7) 0 var(--s-6);
+  border-bottom: 1px solid var(--ama-line);
+}
+
+.mk-title {
+  font-family: var(--font-display);
+  font-size: clamp(1.5rem, 4vw, 2.1rem);
+  line-height: 1.15;
+  color: var(--ama-green-deep);
+  margin: var(--s-3) 0 var(--s-2);
+}
+
+.mk-sub {
+  color: var(--ama-slate);
+  font-size: var(--t-base);
+  margin: 0 0 var(--s-1);
+}
+
+.mk-section {
+  padding: var(--s-6) 0;
+  border-bottom: 1px solid var(--ama-line-2);
+}
+.mk-section:last-of-type { border-bottom: 0; }
+
+.mk-section h2 {
+  font-size: var(--t-lg);
+  color: var(--ama-green-deep);
+  margin: 0 0 var(--s-3);
+}
+
+.mk-section p { color: var(--ama-ink-2); line-height: 1.65; }
+.mk-section li { padding: var(--s-1) 0; color: var(--ama-ink-2); }
+.mk-section a { color: var(--ama-green-deep); }
+
+.mk-foot {
+  text-align: center;
+  padding: var(--s-6) 0 0;
+  color: var(--ama-slate);
+  font-size: var(--t-xs);
+}
+.mk-foot a { color: var(--ama-green-deep); text-decoration: none; }
